# Required for generation. Leave OPENAI_BASE_URL empty when using the provider default.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Default model used by Agents 1-5 when an agent-specific model is not set.
AGENT_DEFAULT_MODEL=

# Required independent terminal verifiers. These must be different model identifiers.
AGENT_FINAL_VERIFIER_A_MODEL=
AGENT_FINAL_VERIFIER_B_MODEL=

# Optional per-agent overrides.
AGENT_CONCEPT_DESIGNER_MODEL=
AGENT_VISUAL_SPECIFIER_MODEL=
AGENT_PAINTER_MODEL=
AGENT_QA_GENERATOR_MODEL=
AGENT_AUDITOR_MODEL=

# Optional overrides for the Stage 4.5 figure-dependency check.
AGENT_MASKING_REWRITE_MODEL=
AGENT_MASKING_VALIDATE_MODEL=
